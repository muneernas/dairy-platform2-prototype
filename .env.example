# Optional: real nexos Gateway (when you have a subscription)
VITE_NEXOS_API_KEY=
VITE_NEXOS_MODEL=GPT 5 mini

# Free LLM stand-in (OpenAI-compatible) — imitates nexos chat + knowledge base
# Groq (recommended free tier): https://console.groq.com/keys
VITE_LLM_API_KEY=
VITE_LLM_BASE_URL=https://api.groq.com/openai/v1
VITE_LLM_MODEL=qwen/qwen3.8-27b

# Alternative — Google Gemini free (OpenAI-compatible endpoint):
# VITE_LLM_API_KEY=your_google_ai_studio_key
# VITE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# VITE_LLM_MODEL=qwen/qwen3.8-27b
